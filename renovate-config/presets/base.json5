{
  // This file is in JSON5 format: https://json5.org
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommits",
    ":prHourlyLimitNone"
  ],
  commitMessageExtra: "to `{{newVersion}}` ({{updateType}})",
  labels: [
    "renovate"
  ],
  ignorePaths: [
    "vendir/"
  ],
  rangeStrategy: "bump",
  packageRules: [
    {
      groupName: "go toolchain",
      matchManagers: [
        "gomod",
        "hermit"
      ],
      matchPackageNames: [
        "go"
      ],
      matchUpdateTypes: [
        "minor",
        "patch"
      ],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true
    },
    {
      groupName: "golangci-lint",
      matchManagers: [
        "github-actions",
        "hermit"
      ],
      matchPackageNames: [
        "golangci-lint"
      ],
      matchUpdateTypes: [
        "minor",
        "patch"
      ],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true
    },
    {
      matchManagers: [
        "gomod"
      ],
      matchUpdateTypes: [
        "minor",
        "patch"
      ],
      matchCurrentVersion: "!/^0/",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true
    },
    {
      matchManagers: [
        "github-actions"
      ],
      matchUpdateTypes: [
        "digest",
        "minor",
        "patch"
      ],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true
    },
    {
      matchManagers: [
        "hermit"
      ],
      matchUpdateTypes: [
        "minor",
        "patch"
      ],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true
    },
    {
      matchManagers: [
        "npm"
      ],
      matchDepTypes: [
        "devDependencies"
      ],
      matchUpdateTypes: [
        "minor",
        "patch"
      ],
      matchCurrentVersion: "!/^0/",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true
    },
    {
      matchManagers: [
        "terraform"
      ],
      matchUpdateTypes: [
        "patch"
      ],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true
    },
    {
      matchManagers: [
        "dockerfile",
        "docker-compose",
        "kubernetes",
        "flux"
      ],
      matchUpdateTypes: [
        "digest"
      ],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true
    }
  ],
  hermit: {
    enabled: true
  }
}
